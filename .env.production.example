# ============================================================
# Production environment — copy to `.env.production` and fill in.
#
# Loaded by docker-compose.prod.yml via `env_file: .env.production`.
# NEVER commit the filled-in file: secrets belong in your deployment
# environment (GitHub Actions secrets, your server's env, a secret manager),
# not in git. `.env.production` is already listed in .gitignore.
# ============================================================

# ----- PostgreSQL -------------------------------------------------
# Must match the `POSTGRES_*` variables of the `postgres` service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=saas_prod
# prisma:// or postgresql:// URL used by api, worker and the migrate job.
# The hostname is the Compose service name (internal network).
DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_password@postgres:5432/saas_prod

# ----- Redis ------------------------------------------------------
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ----- Auth / JWT ---------------------------------------------------
# Generate e.g. with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_random_base64_at_least_32_bytes
JWT_REFRESH_SECRET=CHANGE_ME_another_random_base64
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
REFRESH_COOKIE_NAME=refresh_token

# ----- API ----------------------------------------------------------
API_PREFIX=api/v1
PORT=3001
# Public origin the API may redirect OAuth callbacks to and CORS-allow.
FRONTEND_URL=https://app.example.com

# ----- Web / Next.js -------------------------------------------------
# Where the Next.js SERVER calls the NestJS API (internal Compose name).
API_ORIGIN=http://api:3001
# Public site URL (used for absolute redirects).
NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com

# ----- OAuth (optional) ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://app.example.com/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://app.example.com/api/v1/auth/github/callback

# ----- Email ---------------------------------------------------------
# SMTP relay for transactional email (invitations, report notices).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ----- Reports ---------------------------------------------------------
# Where generated report artifacts live. The api and worker containers must
# both mount the same volume at this path so one writes and the other reads.
REPORTS_DIR=/app/storage/reports

# ----- Monitoring ------------------------------------------------------
# Grafana's initial admin password (change on first login).
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin
