# Dependencies / build outputs (rebuilt inside the image)
node_modules
**/node_modules
**/.next
**/dist
**/.turbo
**/coverage

# Local environment & secrets — never bake into an image
.env
.env.*
!.env.example
apps/*/.env
apps/*/.env.*

# Test & tooling artifacts
**/test-results
**/playwright-report
**/*.log

# Local data (mounted as volumes at runtime)
storage

# VCS & agent runtime
.git
.gitignore
.reasonix
