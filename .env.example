# ===========================================
# API (NestJS) - copy to apps/api/.env
# ===========================================

# App
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database (matches docker-compose.yml postgres service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_db

# Redis (matches docker-compose.yml redis service)
REDIS_URL=redis://localhost:6379
# Individual host/port are used by the worker & RedisService when no URL is set.
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Optional: separate secret for refresh tokens. Falls back to JWT_SECRET.
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Refresh token cookie (httpOnly)
REFRESH_COOKIE_NAME=refresh_token

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=

# Email (Resend for production / Mailpit for local dev, see docker-compose.yml)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# SMTP (local development via Mailpit: smtp://localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Storage (S3/R2)
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# ===========================================
# Worker (NestJS + BullMQ) - copy to apps/worker/.env
# ===========================================

REDIS_HOST=localhost
REDIS_PORT=6379

# ===========================================
# Web (Next.js) - copy to apps/web/.env.local
# ===========================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Stripe (public key only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry
SENTRY_DSN=
