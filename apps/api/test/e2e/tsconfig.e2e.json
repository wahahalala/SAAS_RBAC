{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "module": "CommonJS",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "noEmit": true,
        "baseUrl": "../../",
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": ["./**/*.ts", "../../src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
